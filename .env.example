PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DEMO_MODE=false

# Optional. When unset, outbound texts are recorded in the local outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Opt-in controlled-live prototype. PUBLIC_BASE_URL must be HTTPS.
CONTROLLED_LIVE_MODE=false
CONTROLLED_LIVE_TENANT_PHONE=
CONTROLLED_LIVE_CONTRACTOR_PHONE=
# ISO 8601 timestamp for the contractor's stored enrollment permission for AI voice calls.
CONTROLLED_LIVE_CONTRACTOR_VOICE_ENROLLED_AT=
# At least 32 random characters. The Basic-auth username is "manager".
CONTROLLED_LIVE_MANAGER_PASSWORD=
# Stored fixed agreement price in US cents for the one controlled plumbing journey.
CONTROLLED_LIVE_AGREEMENT_PRICE_CENTS=16000
OPENAI_API_KEY=
# Must support Responses API image input.
OPENAI_TEXT_MODEL=
# OpenAI Realtime SIP project and signed-webhook configuration.
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
